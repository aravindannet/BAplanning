# MongoDB Atlas (same cluster as your other apps is fine; this app uses its own database)
MONGODB_URI=
MONGODB_DB=beast_academy

# Completion email (https://resend.com — free tier). Without RESEND_API_KEY emails are only logged.
RESEND_API_KEY=
NOTIFY_TO=
# Resend's test sender only delivers to your own Resend account email until you verify a domain.
NOTIFY_FROM=Beast Academy <onboarding@resend.dev>

# Optional shared PIN. If set, the app asks for it and the API requires it.
APP_PIN=

# Claude API: hints on practice problems (Haiku) and the problem importer.
ANTHROPIC_API_KEY=

# Passcode needed for "Complete whole chapter" / "Undo all" (parent action)
CHAPTER_PASSCODE=
